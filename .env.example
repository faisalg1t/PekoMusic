# ============================
#   PEKO MUSIC - CONFIGURATION
# ============================

# Get these from https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# Get from @BotFather
BOT_TOKEN=123456:your_bot_token_here
BOT_NAME=Peko Music
BOT_USERNAME=PekoMusicBot

# Assistant account (userbot) string session — must be joined to VC to stream.
# Generate with: python3 -m PekoMusic.generate_session
STRING_SESSION=

# MongoDB connection URI (e.g. from MongoDB Atlas free tier)
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/PekoMusic

# Telegram user_id of the bot owner
OWNER_ID=123456789

# Comma separated list of additional sudo user_ids (optional)
SUDO_USERS=

# Support chat/channel links shown in /start (optional)
SUPPORT_CHAT=https://t.me/YourSupportChat
SUPPORT_CHANNEL=https://t.me/YourSupportChannel

# Log group/channel id where the bot posts startup/shutdown/errors (bot must be admin)
LOG_GROUP_ID=-1001234567890

# Max queue size per chat
MAX_QUEUE_SIZE=15

# Duration limit in minutes for a single track (0 = no limit)
DURATION_LIMIT_MIN=0

# Default audio stream quality: low / medium / high
STREAM_QUALITY=high

# Autoleave assistant from VC after N minutes of inactivity (0 = disabled)
AUTO_LEAVE_MIN=10

# Comma separated cookie file path for yt-dlp (optional, helps avoid throttling)
YT_COOKIES_PATH=

# Web server port used for uptime pings (Heroku/Render style hosting)
PORT=8080
